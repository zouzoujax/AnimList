{
  "name": "animelist",
  "version": "0.2.0",
  "description": "Suivi d'animes local-first, sans compte",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Zaidal",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "release": "npm run build && electron-builder --win --publish always --config electron-builder.yml",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
