{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Crépuscule — neutres prune, primaire ambre, contrôles en pilule. Sombre.",
  "primitive": {
    "color": {
      "neutral": {
        "100": {
          "$value": "#F3EAF9",
          "$type": "color"
        },
        "300": {
          "$value": "#CDB8DD",
          "$type": "color"
        },
        "400": {
          "$value": "#A98FBE",
          "$type": "color"
        },
        "700": {
          "$value": "#3B2750",
          "$type": "color"
        },
        "800": {
          "$value": "#2A1A38",
          "$type": "color"
        },
        "900": {
          "$value": "#1E1229",
          "$type": "color"
        },
        "950": {
          "$value": "#140B1C",
          "$type": "color"
        }
      },
      "brand": {
        "300": {
          "$value": "#FCD34D",
          "$type": "color"
        },
        "400": {
          "$value": "#FBBF24",
          "$type": "color"
        },
        "500": {
          "$value": "#F59E0B",
          "$type": "color"
        }
      },
      "alpha": {
        "border": {
          "$value": "rgb(205 184 221 / 0.14)",
          "$type": "color"
        },
        "border-strong": {
          "$value": "rgb(205 184 221 / 0.3)",
          "$type": "color"
        },
        "scrim": {
          "$value": "rgb(20 11 28 / 0.86)",
          "$type": "color"
        }
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color"
      }
    },
    "radius": {
      "control": {
        "$value": "999px",
        "$type": "dimension"
      },
      "surface": {
        "$value": "20px",
        "$type": "dimension"
      },
      "chip": {
        "$value": "999px",
        "$type": "dimension"
      }
    },
    "shadow": {
      "surface": {
        "$value": "0 16px 40px -28px rgb(245 158 11 / 0.35)",
        "$type": "shadow"
      },
      "poster": {
        "$value": "0 16px 34px -20px rgb(0 0 0 / 0.9)",
        "$type": "shadow"
      }
    },
    "font": {
      "body": {
        "$value": "'Montserrat Variable', 'Segoe UI', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "display": {
        "$value": "'Space Grotesk Variable', 'Segoe UI', system-ui, sans-serif",
        "$type": "fontFamily"
      }
    },
    "number": {
      "ambient": {
        "$value": "0.4",
        "$type": "number"
      },
      "heading-weight": {
        "$value": "700",
        "$type": "number"
      }
    }
  },
  "semantic": {
    "ds": {
      "scheme": {
        "$value": "dark"
      },
      "ambient": {
        "$value": "{primitive.number.ambient}"
      },
      "scrim": {
        "$value": "{primitive.color.alpha.scrim}"
      },
      "color": {
        "background": {
          "$value": "{primitive.color.neutral.950}"
        },
        "surface": {
          "$value": "{primitive.color.neutral.900}"
        },
        "surface-raised": {
          "$value": "{primitive.color.neutral.800}"
        },
        "border": {
          "$value": "{primitive.color.alpha.border}"
        },
        "border-strong": {
          "$value": "{primitive.color.alpha.border-strong}"
        },
        "foreground": {
          "$value": "{primitive.color.neutral.100}"
        },
        "foreground-muted": {
          "$value": "{primitive.color.neutral.300}"
        },
        "foreground-subtle": {
          "$value": "{primitive.color.neutral.400}"
        },
        "primary": {
          "$value": "{primitive.color.brand.400}"
        },
        "primary-hover": {
          "$value": "{primitive.color.brand.300}"
        },
        "primary-foreground": {
          "$value": "#140B1C"
        },
        "ring": {
          "$value": "{primitive.color.brand.300}"
        }
      },
      "font": {
        "body": {
          "$value": "{primitive.font.body}"
        },
        "display": {
          "$value": "{primitive.font.display}"
        }
      },
      "heading": {
        "weight": {
          "$value": "{primitive.number.heading-weight}"
        },
        "tracking": {
          "$value": "-0.035em"
        }
      },
      "elevation": {
        "surface": {
          "$value": "{primitive.shadow.surface}"
        },
        "poster": {
          "$value": "{primitive.shadow.poster}"
        }
      }
    }
  },
  "component": {
    "ds": {
      "chrome": {
        "bg": {
          "$value": "{primitive.color.neutral.900}"
        }
      },
      "card": {
        "bg": {
          "$value": "{primitive.color.neutral.900}"
        },
        "bg-hover": {
          "$value": "{primitive.color.neutral.800}"
        },
        "border": {
          "$value": "{primitive.color.alpha.border}"
        },
        "radius": {
          "$value": "{primitive.radius.surface}"
        },
        "shadow": {
          "$value": "{primitive.shadow.surface}"
        }
      },
      "button": {
        "bg": {
          "$value": "{primitive.color.neutral.800}"
        },
        "fg": {
          "$value": "{primitive.color.neutral.100}"
        },
        "border": {
          "$value": "{primitive.color.alpha.border}"
        },
        "radius": {
          "$value": "{primitive.radius.control}"
        },
        "primary-bg": {
          "$value": "{primitive.color.brand.400}"
        },
        "primary-hover-bg": {
          "$value": "{primitive.color.brand.300}"
        },
        "primary-fg": {
          "$value": "#140B1C"
        }
      },
      "input": {
        "bg": {
          "$value": "{primitive.color.neutral.950}"
        },
        "border": {
          "$value": "{primitive.color.alpha.border-strong}"
        }
      },
      "chip": {
        "radius": {
          "$value": "{primitive.radius.chip}"
        }
      },
      "poster": {
        "shadow": {
          "$value": "{primitive.shadow.poster}"
        }
      }
    }
  }
}
